; Patógena S.A. — proyecto Godot 4
config_version=5

[application]
config/name="Patógena S.A."
run/main_scene="res://escenas/principal.tscn"
config/description="Fábrica 3D isométrica de un laboratorio que provoca un apocalipsis zombi."
config/features=PackedStringArray("4.7", "Forward Plus")

[internationalization]
locale/fallback="es"
locale/translations=PackedStringArray("res://locale/textos.es.translation", "res://locale/textos.en.translation")

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_taa=true
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=4
environment/ssao/quality=3
environment/ssao/half_size=false
environment/ssil/quality=2
textures/default_filters/anisotropic_filtering_level=4

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]
theme/custom_font_size=16

[autoload]
Captura="*res://scripts/captura.gd"
